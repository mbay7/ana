# Setting names only. Copy to .env and fill in values there; .env is never committed.

# Model access
OPENROUTER_API_KEY=

# Which brand folder under clients/ to serve (default: demo)
CLIENT=

# Owner pages (Usage, Build): both must be set, and the password entered, to open them
ANA_ADMIN=
ANA_ADMIN_PASSWORD=

# Logs: days to keep (default 30; 0 keeps everything)
ANA_LOG_RETENTION_DAYS=

# Limits (0 switches a limit off). Defaults: 40, 6, 10, 20.0
ANA_MAX_MESSAGES_PER_CHAT=
ANA_MAX_MESSAGES_PER_MINUTE=
ANA_MAX_VISITOR_MESSAGES_PER_MINUTE=
ANA_MONTHLY_SPEND_USD=
# Model price in US dollars per million tokens, for the spend estimate. Defaults: 0.5, 1.5
ANA_PRICE_IN_PER_MTOK=
ANA_PRICE_OUT_PER_MTOK=
